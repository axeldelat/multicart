# Plunk (envío del formulario de contacto). Cuenta en infraestructura "next".
# Secret key del proyecto Multicart (Settings -> API Credentials). Solo server-side.
PLUNK_SECRET_API_KEY=sk_xxx
# Public key (tracking client-side; opcional para el formulario).
PLUNK_PUBLIC_API_KEY=pk_xxx

# reCAPTCHA v3 (formulario de contacto). Consola: https://www.google.com/recaptcha/admin
# Site key. No lleva NEXT_PUBLIC_: la lee ContactBlock (server) y la pasa como prop.
RECAPTCHA_KEY=6Lxxx
# Secret key, solo server-side (verificación en lib/recaptcha.ts).
RECAPTCHA_SECRET_KEY=6Lxxx
